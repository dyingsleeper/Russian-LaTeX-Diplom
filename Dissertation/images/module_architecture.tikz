\begin{tikzpicture}[
        thick,
        >=stealth,
        block/.style={
                draw,
                rounded corners=2pt,
                align=center,
                text width=24mm,
                minimum height=12mm,
                inner sep=3pt,
                font=\scriptsize,
            },
        ctrl/.style={
                draw,
                rounded corners=2pt,
                align=center,
                text width=34mm,
                minimum height=10mm,
                inner sep=3pt,
                font=\scriptsize,
                fill=black!4,
            },
        store/.style={
                draw,
                rounded corners=2pt,
                align=center,
                text width=128mm,
                minimum height=12mm,
                inner sep=3pt,
                font=\scriptsize,
                fill=black!4,
            },
        flow/.style={->, thick},
        dataflow/.style={<->, thick, dashed},
    ]

    \node[ctrl] (control) at (-60mm, 32mm) {Управление\\процессом};
    \node[ctrl] (queue)   at (-60mm, 17mm) {Очередь\\этапов};

    \node[block] (email) at (-60mm, 0mm) {Синхронизация\\и нормализация};
    \node[block] (embed) at (-30mm, 0mm) {Построение\\эмбеддингов};
    \node[block] (clust) at (  0mm, 0mm) {Кластеризация};
    \node[block] (ann)   at ( 30mm, 0mm) {Ручная\\проверка};
    \node[block] (clf)   at ( 60mm, 0mm) {Классификация\\и оценка};

    \node[store] (store) at (0mm, -28mm)
        {PostgreSQL-хранилище\\письма, нормализованные тексты, эмбеддинги, кластеры, метки, версии};

    \draw[flow] (control.south) -- (queue.north);
    \draw[flow] (queue.south) -- (email.north);

    \draw[flow] (email.east) -- (embed.west);
    \draw[flow] (embed.east) -- (clust.west);
    \draw[flow] (clust.east) -- (ann.west);
    \draw[flow] (ann.east) -- (clf.west);

    \draw[dataflow] (email.south) -- (email |- store.north);
    \draw[dataflow] (embed.south) -- (embed |- store.north);
    \draw[dataflow] (clust.south) -- (clust |- store.north);
    \draw[dataflow] (ann.south)   -- (ann   |- store.north);
    \draw[dataflow] (clf.south)   -- (clf   |- store.north);
\end{tikzpicture}
